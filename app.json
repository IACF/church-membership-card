{
  "expo": {
    "name": "Copvasf",
    "slug": "copvasf",
    "version": "1.0.0",
    "scheme": "copvasf",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.org.copvasf.carteirinha",
      "buildNumber": "1"
    },
    "android": {
      "package": "br.org.copvasf.carteirinha",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "71d5342b-eac2-4899-9b03-1d221b0460ac"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-asset"],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
